# ==============================================================================
# Khmer Government Document Intelligence System - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=Khmer Government Document Intelligence System
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=cambodia_gov_doc_secret_key_change_in_production_min_32_chars

# Tesseract OCR Configuration (Windows 11)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_DIR=C:\Users\TUF\tesseract-data\
OCR_DEFAULT_LANGUAGES=khm+eng
OCR_FALLBACK_LANGUAGES=eng

# File Storage & Upload Security
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads/documents
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf

# Database Configuration (PostgreSQL with SQLAlchemy)
# Default for dev fallback is SQLite if PostgreSQL instance is being configured
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/khmer_gov_docs
# Set to true to automatically fallback to SQLite for local development/testing if PostgreSQL is unreachable:
DB_FALLBACK_SQLITE=true
SQLITE_URL=sqlite:///./khmer_gov_docs.db

# Security & Data Privacy
DATA_ENCRYPTION_KEY=cambodia_sec_key_32_bytes_len!
LOG_LEVEL=INFO
MASK_SENSITIVE_LOGS=true
CONFIDENCE_THRESHOLD_HIGH=80.0
CONFIDENCE_THRESHOLD_MEDIUM=50.0
