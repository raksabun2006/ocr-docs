# ==============================================================================
# Khmer Government Document Intelligence Platform - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=Khmer Government Document Intelligence System
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=cambodia_gov_doc_secret_key_change_in_production_min_32_chars

# Authentication & RBAC Policies
JWT_SECRET_KEY=cambodia_gov_doc_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Tesseract OCR Configuration
# Windows Example:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_DIR=C:\Users\TUF\tesseract-data
# Linux Example:
# TESSERACT_CMD=/usr/bin/tesseract
# TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata
OCR_DEFAULT_LANGUAGES=khm+eng
OCR_FALLBACK_LANGUAGES=eng
DEFAULT_OCR_PROVIDER=TESSERACT

# Ollama AI Vision Model Configuration (Optional / Hybrid)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl
OLLAMA_TIMEOUT_SECONDS=30

# File Storage & Upload Security
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads/documents
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf

# Database Configuration (PostgreSQL + SQLite Development Fallback)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/khmer_gov_docs
DB_FALLBACK_SQLITE=true
SQLITE_URL=sqlite:///./khmer_gov_docs.db

# Security & Data Privacy
DATA_ENCRYPTION_KEY=cambodia_sec_key_32_bytes_len!
LOG_LEVEL=INFO
MASK_SENSITIVE_LOGS=true
CONFIDENCE_THRESHOLD_HIGH=80.0
CONFIDENCE_THRESHOLD_MEDIUM=50.0
